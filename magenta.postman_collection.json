{
  "info": {
    "name": "Magenta Media Server",
    "description": "Collection complète pour tester et administrer le serveur Magenta.\n\n**Setup :**\n1. Définir la variable `base_url` (ex: http://192.168.1.2:8080)\n2. Créer un appareil via POST /admin/devices\n3. Copier le token dans la variable `token`\n4. Toutes les routes protégées utiliseront ce token automatiquement",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "description": "URL de base du serveur (changer pour l'IP locale en test depuis un autre appareil)"
    },
    {
      "key": "token",
      "value": "",
      "description": "Token d'authentification (obtenu via POST /admin/devices)"
    },
    {
      "key": "media_id",
      "value": "",
      "description": "ID d'un média (obtenu via GET /api/media)"
    },
    {
      "key": "device_id",
      "value": "",
      "description": "ID d'un appareil (obtenu via GET /admin/devices)"
    }
  ],
  "item": [
    {
      "name": "🟢 Santé",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health",
            "description": "Vérifie que le serveur est actif. Aucun token requis."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Service magenta', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('ok');",
                  "  pm.expect(json.service).to.eql('magenta');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "🔐 Admin — Appareils",
      "description": "Routes d'administration accessibles uniquement depuis localhost",
      "item": [
        {
          "name": "Lister les appareils",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/devices",
            "description": "Retourne la liste de tous les appareils autorisés avec leurs tokens.\n\n⚠️ Accessible uniquement depuis localhost."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Contient devices', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('devices');",
                  "  pm.expect(json).to.have.property('total');",
                  "});",
                  "// Sauvegarde automatique du premier device_id",
                  "const json = pm.response.json();",
                  "if (json.devices && json.devices.length > 0) {",
                  "  pm.collectionVariables.set('device_id', json.devices[0].id);",
                  "  console.log('device_id sauvegardé:', json.devices[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Ajouter un appareil",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/admin/devices",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mon iPhone\"\n}"
            },
            "description": "Crée un nouvel appareil autorisé et retourne son token.\n\nLe token retourné doit être copié dans la variable `token` de la collection.\n\n⚠️ Accessible uniquement depuis localhost."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Contient token', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('token');",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.expect(json).to.have.property('name');",
                  "});",
                  "// Sauvegarde automatique du token et device_id",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.token);",
                  "pm.collectionVariables.set('device_id', json.id);",
                  "console.log('Token sauvegardé automatiquement:', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Révoquer un appareil",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/admin/devices/{{device_id}}",
            "description": "Révoque l'accès d'un appareil. Son token ne fonctionnera plus immédiatement.\n\n⚠️ Accessible uniquement depuis localhost."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Message succès', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.message).to.include('révoqué');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "🎬 Médias",
      "description": "Routes pour lister et accéder aux médias. Token requis.",
      "item": [
        {
          "name": "Lister tous les médias",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/media?token={{token}}",
              "host": ["{{base_url}}"],
              "path": ["api", "media"],
              "query": [
                {
                  "key": "token",
                  "value": "{{token}}"
                }
              ]
            },
            "description": "Retourne la liste complète des fichiers multimédias indexés.\n\nRéponse : { total: N, items: [...] }"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Contient items', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('items');",
                  "  pm.expect(json).to.have.property('total');",
                  "});",
                  "// Sauvegarde automatique du premier media_id",
                  "const json = pm.response.json();",
                  "if (json.items && json.items.length > 0) {",
                  "  pm.collectionVariables.set('media_id', json.items[0].id);",
                  "  console.log('media_id sauvegardé:', json.items[0].id, '-', json.items[0].name);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Épisode suivant",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/media/{{media_id}}/next?token={{token}}",
              "host": ["{{base_url}}"],
              "path": ["api", "media", "{{media_id}}", "next"],
              "query": [
                {
                  "key": "token",
                  "value": "{{token}}"
                }
              ]
            },
            "description": "Retourne le média suivant dans le même dossier (ordre alphabétique).\n\nRetourne 404 si c'est le dernier fichier du dossier."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 ou 404', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Contient id et name', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.expect(json).to.have.property('name');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Générer playlist M3U",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/playlist?folder=D:/Videos&token={{token}}",
              "host": ["{{base_url}}"],
              "path": ["api", "playlist"],
              "query": [
                {
                  "key": "folder",
                  "value": "D:/Videos",
                  "description": "Chemin du dossier (changer selon ta config)"
                },
                {
                  "key": "token",
                  "value": "{{token}}"
                }
              ]
            },
            "description": "Génère une playlist M3U pour tous les fichiers d'un dossier.\n\nOuvrir le fichier .m3u dans VLC pour lire tous les épisodes dans l'ordre."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 ou 404', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Format M3U valide', () => {",
                  "    pm.expect(pm.response.text()).to.include('#EXTM3U');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "📺 Streaming",
      "description": "Route de streaming vidéo. Supporte les range requests.",
      "item": [
        {
          "name": "Stream un média",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/stream/{{media_id}}?token={{token}}",
              "host": ["{{base_url}}"],
              "path": ["stream", "{{media_id}}"],
              "query": [
                {
                  "key": "token",
                  "value": "{{token}}"
                }
              ]
            },
            "description": "Streame un fichier multimédia.\n\nSupporte les range requests HTTP (RFC 7233) pour le scrubbing dans VLC.\n\n**Pour VLC :** copier l'URL complète et l'ouvrir via Média → Ouvrir un flux réseau."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 ou 206', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 206]);",
                  "});",
                  "pm.test('Accept-Ranges présent', () => {",
                  "  pm.expect(pm.response.headers.get('Accept-Ranges')).to.eql('bytes');",
                  "});",
                  "pm.test('Content-Type vidéo', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('video/');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Stream — Token invalide (test sécurité)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/stream/{{media_id}}?token=INVALID_TOKEN",
              "host": ["{{base_url}}"],
              "path": ["stream", "{{media_id}}"],
              "query": [
                {
                  "key": "token",
                  "value": "INVALID_TOKEN"
                }
              ]
            },
            "description": "Teste que le serveur refuse un token invalide avec 401 Unauthorized."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Stream — Sans token (test sécurité)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/stream/{{media_id}}",
            "description": "Teste que le serveur refuse une requête sans token avec 401 Unauthorized."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
